FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/Your-Project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.6-luna
AZURE_AI_API_KEY=your-foundry-or-azure-openai-api-key

# Primary Snowflake MCP connection: repo-root mcp_config.json (mcp-remote + static OAuth)
MCP_CONFIG_PATH=mcp_config.json
# Auth mode: oauth (default, mcp-remote) | pat (Bearer programmatic access token)
# SNOWFLAKE_MCP_AUTH=oauth
# Optional env mirrors (auto-filled from mcp_config when unset)
# SNOWFLAKE_MCP_SERVER_URL=
# SNOWFLAKE_OAUTH_CLIENT_ID=
# SNOWFLAKE_OAUTH_CLIENT_SECRET=
# When SNOWFLAKE_MCP_AUTH=pat:
# SNOWFLAKE_PAT=

# Neon Postgres — email_processing pipeline only (not Snowflake payroll)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/neondb?sslmode=require

APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
TRIAGE_BLOB_CONTAINER=payroll-triage
TRIAGE_LOCAL_STORE_PATH=.local_store
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_ALLOWLIST=
DEFAULT_LOOKBACK_DAYS=7
DEFAULT_INTERVAL_HOURS=4
FOUNDRY_AGENT_INVOKE_URL=
# Browser origins allowed to call the API (Outlook add-in task pane), comma-separated
CORS_ALLOWED_ORIGINS=https://localhost:3000
