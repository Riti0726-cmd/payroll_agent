# Copy to .env. Values are inlined into the bundle at build time — never put secrets here.

# Sign-in (Entra SPA registration shared with web/). Set true ONLY for local UI work without Entra.
VITE_AUTH_DISABLED=false
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=
# Used only when VITE_AUTH_DISABLED=true
VITE_DEV_SPECIALIST_ID=default

# Backend base URL. Local: /api (webpack dev server proxies to http://127.0.0.1:8088).
# Deployed: full HTTPS URL of the Python host; add the add-in origin to its CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api
# Optional Neon payroll_specialist_email override (same as web/)
# VITE_QUEUE_MAILBOX=payroll@peoservices.com

# Build-time only (not shipped to the browser)
# Production host for taskpane.html etc.; manifest URLs are rewritten to this. Must end with "/".
ADDIN_PROD_URL=
# Dev proxy target for /api
ADDIN_DEV_API_TARGET=http://127.0.0.1:8088
