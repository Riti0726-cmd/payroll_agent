# Auth: set true ONLY for automated UI tests. Production / demo to stakeholders: false + Entra.
VITE_AUTH_DISABLED=false

# Entra ID (SPA) — required when VITE_AUTH_DISABLED=false
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/redirect.html
VITE_ENTRA_API_SCOPE=

# Local: /api/foundry (Vite proxies to http://127.0.0.1:8088/responses)
# Deployed: full Foundry Responses invoke URL
VITE_FOUNDRY_INVOKE_URL=/api/foundry

# Local: /api/qa (Vite proxies to http://127.0.0.1:8088/qa)
# Standalone Q&A agent — do not point this at the Foundry triage invoke URL
VITE_QA_INVOKE_URL=/api/qa

# Local: /api/queue (Vite proxies to http://127.0.0.1:8088/queue)
# Neon-backed open queue — requires DATABASE_URL on the Python host
VITE_QUEUE_URL=/api/queue
# Optional: Neon payroll_specialist_email to list (local specialist "default" has no real mailbox)
# VITE_QUEUE_MAILBOX=payroll@peoservices.com

# Local: /api/history (Vite proxies to http://127.0.0.1:8088/history)
VITE_HISTORY_URL=/api/history

# Local: /api/settings (Vite proxies to http://127.0.0.1:8088/settings)
VITE_SETTINGS_URL=/api/settings

# Local: /api/drafts (Vite proxies to http://127.0.0.1:8088/drafts)
# Neon-backed pending drafts — requires DATABASE_URL
VITE_DRAFTS_URL=/api/drafts

# Local: /api/changelists (Vite proxies to http://127.0.0.1:8088/changelists)
# Neon-backed pending change lists — requires DATABASE_URL
VITE_CHANGELISTS_URL=/api/changelists

# Local: /api/triage/stream (Vite proxies to http://127.0.0.1:8088/triage/stream)
# SSE live progress for Run triage (Graph Bearer)
VITE_TRIAGE_STREAM_URL=/api/triage/stream
